# ============================================================
# RegulaSync Environment Variables
# Copy this file to .env for local development
# Set these as Railway environment variables for production
# ============================================================

# Database (MySQL) — Railway provides this automatically when you add a MySQL plugin
DATABASE_URL=mysql://user:password@localhost:3306/regulasync

# JWT Secret — generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this

# OpenAI API Key — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Stripe (optional — for payment processing)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Node environment
NODE_ENV=production

# Port (Railway sets this automatically)
PORT=3000
